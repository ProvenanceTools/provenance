test-workspace/scratch.py
test-workspace-policy/scratch.py
.env
.claude/
.superpowers/

# Generated large test fixtures (multi-GB, never committed)
packages/server/scripts/fixtures/

# IRB / research-ethics documents (consent forms, protocols, recruitment, interviews)
irb/

# Python bytecode / test caches (tools/)
__pycache__/
.pytest_cache/

# Local working notes + DEV key material (dev-keypair.json, dev-root-keypair.json).
# Machine-local only: these hold PRIVATE keys. Previously covered solely by
# .git/info/exclude, which is never shared, so a fresh clone had no protection.
.notes/
